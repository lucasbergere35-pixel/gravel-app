{
  "name": "gravel-compagnon",
  "private": true,
  "version": "0.1.0",
  "description": "PWA pour préparer et suivre ses sorties en vélo gravel (GPX, carte, GPS, nutrition).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "idb": "^8.0.4",
    "lucide": "^1.70.0",
    "maplibre-gl": "^6.17.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "jsdom": "^31.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
